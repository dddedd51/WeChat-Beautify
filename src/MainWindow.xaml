<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="微信美化 · 主题工作室" Width="1170" Height="810" MinWidth="1030" MinHeight="730" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="#F1F4FA" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E9F1FC"/><Setter Property="Background" Value="#33485E"/><Setter Property="BorderBrush" Value="#305D7B98"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5B5CA"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,13"/></Style>
 </Window.Resources>
 <Border Background="#B0172434" Padding="30,25">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Border Width="40" Height="40" Background="#506DA1D7" CornerRadius="12" Margin="0,0,13,0"><TextBlock Text="美" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="微信美化" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="WECHAT  /  THEME STUDIO" Foreground="#85A0C0" FontSize="10" Margin="1,4,0,0"/></StackPanel></StackPanel><TextBlock Text="让界面透出光，让对话保持清晰。" Foreground="#C1CCDC" Margin="0,15,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border Background="#30476B8F" BorderBrush="#42698BAD" BorderThickness="1" CornerRadius="15" Padding="13,7" HorizontalAlignment="Right"><TextBlock Text="EXPERIMENTAL  0.4" FontSize="10" Foreground="#B9D7F8"/></Border><TextBlock x:Name="Connection" Text="检查连接…" Foreground="#C7D6E8" FontSize="12" Margin="0,16,0,0"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="272"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#951C2B3E" CornerRadius="16" BorderBrush="#30678AAE" BorderThickness="1" Padding="21">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="01   自定义背景" Style="{StaticResource Section}"/>
       <UniformGrid Columns="2"><Button x:Name="ChooseImage" Content="选择图片…" Background="#456B91" Padding="9,10"/><Button x:Name="ClearImage" Content="清除背景" Padding="9,10" Margin="0"/></UniformGrid>
       <Button x:Name="CropImage" Content="裁剪与定位…" Padding="9,8" Margin="0,10,0,0"/><TextBlock x:Name="ImageName" Text="未选择图片 · 使用系统毛玻璃" Style="{StaticResource Hint}" Margin="0,9,0,13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
       <StackPanel x:Name="ImageEffects">
        <Grid><TextBlock Text="图片模糊"/><TextBlock x:Name="BlurLabel" Text="8" HorizontalAlignment="Right" Foreground="#96C7FF"/></Grid>
        <Slider x:Name="ImageBlur" Minimum="0" Maximum="30" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,15"/>
        <Grid><TextBlock Text="明暗遮罩"/><TextBlock x:Name="ShadeLabel" Text="28%" HorizontalAlignment="Right" Foreground="#96C7FF"/></Grid>
        <Slider x:Name="ImageShade" Minimum="0" Maximum="85" Value="28" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,5"/>
        <TextBlock Text="浅色时提亮，深色时压暗。" Style="{StaticResource Hint}"/>
       </StackPanel>
       <CheckBox x:Name="Dark" Content="深色主题" Foreground="#DBE6F5" Margin="0,16,0,0"/>
       <Border Height="1" Background="#30678AAE" Margin="0,18,0,18"/>
       <TextBlock Text="02   玻璃材质" Style="{StaticResource Section}"/>
       <TextBlock x:Name="ModeDescription" Text="无背景图时，使用系统毛玻璃。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
       <Grid><TextBlock Text="磨砂浓度"/><TextBlock x:Name="DensityLabel" Text="65%" HorizontalAlignment="Right" Foreground="#96C7FF"/></Grid>
       <Slider x:Name="Density" Minimum="20" Maximum="95" Value="65" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,13,0,6"/>
       <Grid><TextBlock Text="通透" Style="{StaticResource Hint}"/><TextBlock Text="柔和" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
       <Border Height="1" Background="#30678AAE" Margin="0,18,0,18"/>
       <TextBlock Text="03   对话配色" Style="{StaticResource Section}"/>
       <UniformGrid Columns="3"><Button x:Name="Blue" Content="雾蓝" Background="#375F87" Padding="9,9"/><Button x:Name="Green" Content="青玉" Background="#32665F" Padding="9,9"/><Button x:Name="Purple" Content="鸢尾" Background="#635482" Padding="9,9" Margin="0"/></UniformGrid>
       <Button x:Name="EditColors" Content="分区自定义颜色…" Padding="9,10" Margin="0,12,0,0"/>
       <TextBlock Text="导航、列表、聊天、输入与气泡独立配色" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
       <TextBlock x:Name="AccentLabel" Text="当前：雾蓝" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
       <Border Height="1" Background="#30678AAE" Margin="0,24,0,22"/>
       <TextBlock Text="04   微信连接" Style="{StaticResource Section}"/>
       <TextBlock x:Name="Detection" Text="正在检测微信…" Foreground="#B5D5F3" LineHeight="22"/>
       <TextBlock Text="严格匹配 4.1.15.56 x64" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
       <WrapPanel><Button x:Name="Detect" Content="重新检测" Padding="10,8"/><Button x:Name="Choose" Content="选择位置" Padding="10,8" Margin="0"/></WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </Border>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><TextBlock Text="材质与配色示意" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="MaterialLabel" Text="系统材质预览" HorizontalAlignment="Right" Foreground="#A9C3E2" FontSize="11"/></Grid>
     <Border x:Name="Preview" Grid.Row="1" Background="#60E8EEF4" CornerRadius="17" BorderThickness="1" BorderBrush="#709AAEC5" ClipToBounds="True">
     </Border>
     <Border Grid.Row="2" Background="#702E425A" CornerRadius="11" Padding="15,12" Margin="0,15,0,0"><StackPanel><Grid><TextBlock x:Name="ContrastSummary" Text="文字可读性检查" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><Button x:Name="ImproveContrast" Content="采用建议遮罩" HorizontalAlignment="Right" Padding="10,6" FontSize="11" Margin="0" IsEnabled="False"/></Grid><TextBlock x:Name="ContrastDetails" Text="选图后检查背景与配置文字色的对比度。" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="首次应用：完全退出微信 → 启动主题微信 → 登录后更新主题。" Foreground="#9EBCDD" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
    </Grid>
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,22,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel x:Name="Actions"><Button x:Name="Launch" Content="启动主题微信" Background="#FF85B8E7" Foreground="#FF142B42" FontWeight="SemiBold"/><Button x:Name="Apply" Content="更新主题"/><Button x:Name="Restore" Content="恢复默认"/></WrapPanel><Button x:Name="Report" Grid.Column="1" Content="导出诊断" Background="Transparent" BorderThickness="0" Foreground="#A5BDD8" Margin="0"/></Grid>
    <TextBlock x:Name="Status" Text="正在初始化…" FontSize="11" Foreground="#AAC0DA" Margin="0,12,0,0" MinHeight="35" LineHeight="18"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
