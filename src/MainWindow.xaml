<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="微信美化 · 青屿" Width="1220" Height="820" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F4F8F7" Foreground="#173C38" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#68827B"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#234E46"/><Setter Property="BorderBrush" Value="#D9E7E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.77"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#168E85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#617B73"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Box" CornerRadius="10" Padding="17,14" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#DCF3EC"/><Setter Property="Foreground" Value="#126A60"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,12,0,18"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#E0EBE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
 <Grid Background="#F4F8F7">
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#FCFEFD" BorderBrush="#E0EBE5" BorderThickness="0,0,1,0" Padding="17,28,17,22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="11,0,0,36"><Border Width="43" Height="43" CornerRadius="14" Background="#39C5BB" HorizontalAlignment="Left"><TextBlock Text="美" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#103B3A"/></Border><TextBlock Text="微信美化" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBlock Text="THEME STUDIO" FontSize="10" Foreground="#7D958B"/></StackPanel>
    <StackPanel Grid.Row="1"><RadioButton x:Name="NavTheme" Content="◈    主题空间" Style="{StaticResource Nav}" GroupName="pages" IsChecked="True"/><RadioButton x:Name="NavBackground" Content="▧    背景与构图" Style="{StaticResource Nav}" GroupName="pages"/><RadioButton x:Name="NavColors" Content="◉    分区配色" Style="{StaticResource Nav}" GroupName="pages"/><RadioButton x:Name="NavGuide" Content="≡    使用指南" Style="{StaticResource Nav}" GroupName="pages"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="11,0,0,0"><Border Background="#E7F6EF" CornerRadius="8" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="滚动修复 · 0.7.1 预览版" Foreground="#287764" FontSize="10"/></Border><TextBlock Text="让每次打开，都有好心情。" Style="{StaticResource Hint}" FontSize="10" Margin="0,12,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,19">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR SPACE, YOUR COLOUR" FontSize="10" Foreground="#769087" Margin="0,0,0,7"/><TextBlock x:Name="PageTitle" Text="给微信一点自己的颜色" FontSize="26" FontWeight="SemiBold"/></StackPanel><Border Grid.Column="1" Background="White" CornerRadius="20" Padding="14,10" BorderBrush="#DCE9E2" BorderThickness="1" VerticalAlignment="Center"><TextBlock x:Name="Connection" Text="正在检查连接" FontSize="11" Foreground="#537B6C"/></Border></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="Studio"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="21">
      <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
       <StackPanel>
        <StackPanel x:Name="ThemePage">
         <TextBlock Text="精选主题" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
         <Border CornerRadius="13" Padding="14" Margin="0,0,0,12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BDEFE5" Offset="0"/><GradientStop Color="#EDF8E9" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="青 屿" FontSize="25" FontWeight="Light"/><TextBlock Text="QINGYU / 39C5BB" FontSize="10" Foreground="#3E7D6F" Margin="0,4,0,12"/><Button x:Name="Mint" Content="使用青屿主题  →" Padding="10,9" Background="#39C5BB" BorderThickness="0" Foreground="#103B3A" FontWeight="SemiBold"/></StackPanel></Border>
         <TextBlock Text="更多强调色" Style="{StaticResource Hint}" Margin="0,0,0,6"/><UniformGrid Columns="3"><Button x:Name="Blue" Content="雾蓝" Padding="8,8" Background="#E4EDF8" Margin="0,0,5,0"/><Button x:Name="Green" Content="青玉" Padding="8,8" Background="#E0F2E9" Margin="0,0,5,0"/><Button x:Name="Purple" Content="鸢尾" Padding="8,8" Background="#EFEBF7"/></UniformGrid>
         <TextBlock x:Name="AccentLabel" Text="当前：青屿" Style="{StaticResource Hint}" Margin="0,7,0,10"/>
         <Border Height="1" Background="#E4EDE7" Margin="0,0,0,12"/><TextBlock Text="连接微信" Style="{StaticResource Heading}" FontSize="15" Margin="0,0,0,6"/><TextBlock x:Name="Detection" Text="正在检测本机版本…" Style="{StaticResource Hint}" LineHeight="18"/><TextBlock x:Name="CompatibilitySummary" Text="4.1.15.X / 4.2.0.X · x64" Style="{StaticResource Hint}" LineHeight="17" FontSize="10" Margin="0,6,0,9"/><UniformGrid Columns="2"><Button x:Name="Detect" Content="重新检测" Padding="8,8" Margin="0,0,6,0"/><Button x:Name="Choose" Content="选择位置" Padding="8,8"/></UniformGrid>
        </StackPanel>
        <StackPanel x:Name="BackgroundPage" Visibility="Collapsed"><TextBlock Text="让背景成为你的风格" Style="{StaticResource Heading}"/><TextBlock Text="在右侧微信示意图里拖动、缩放，避开文字与按钮区域。" Style="{StaticResource Hint}" Margin="0,0,0,18"/>
         <Button x:Name="ChooseImage" Content="＋  选择背景图片" Background="#39C5BB" BorderThickness="0" Foreground="#103B3A"/><TextBlock x:Name="ImageName" Text="未选择背景" Style="{StaticResource Hint}" Margin="0,9,0,14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
         <UniformGrid Columns="2"><Button x:Name="CropImage" Content="在预览中构图" Padding="8,9" Margin="0,0,6,0"/><Button x:Name="ClearImage" Content="使用纯色" Padding="8,9"/></UniformGrid>
         <StackPanel x:Name="ImageEffects" Margin="0,25,0,0"><Grid><TextBlock Text="图片模糊"/><TextBlock x:Name="BlurLabel" HorizontalAlignment="Right" Foreground="#168E85"/></Grid><Slider x:Name="ImageBlur" Minimum="0" Maximum="30" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/><Grid><TextBlock Text="明暗遮罩"/><TextBlock x:Name="ShadeLabel" HorizontalAlignment="Right" Foreground="#168E85"/></Grid><Slider x:Name="ImageShade" Minimum="0" Maximum="85" Value="28" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="浅色方案提亮图片，深色方案压暗图片。" Style="{StaticResource Hint}"/></StackPanel>
         <TextBlock x:Name="ModeDescription" Style="{StaticResource Hint}" Margin="0,20,0,0"/>
         <StackPanel Visibility="Collapsed"><TextBlock x:Name="DensityLabel"/><Slider x:Name="Density" Minimum="20" Maximum="95" Value="65"/></StackPanel>
        </StackPanel>
        <StackPanel x:Name="ColorsPage" Visibility="Collapsed"><TextBlock Text="颜色，细到每一区" Style="{StaticResource Heading}"/><TextBlock Text="点击右侧预览选择区域，或打开配色编辑器。" Style="{StaticResource Hint}" Margin="0,0,0,22"/><Border Background="#E7F6EF" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="当前可应用" FontWeight="SemiBold"/><TextBlock Text="导航 · 会话列表 · 聊天背景 · 输入背景 · 选中会话 · 列表文字" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel></Border><Button x:Name="EditColors" Content="打开分区配色编辑器  →" Background="#39C5BB" Foreground="#103B3A" BorderThickness="0" Margin="0,18,0,16"/><TextBlock Text="消息气泡、正文与图标暂保留微信原样。其他页面逐步适配。" Style="{StaticResource Hint}"/><Border Height="1" Background="#E4EDE7" Margin="0,24,0,20"/><CheckBox x:Name="Dark" Content="编辑深色方案" Foreground="#315B4F"/><TextBlock Text="两套配色分别保存；深色背景仍需结合实际微信检查原生内容的对比度。" Style="{StaticResource Hint}" Margin="0,11,0,0"/></StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBlock Text="外观预览" FontWeight="SemiBold"/><TextBlock x:Name="MaterialLabel" Text="示例消息 · 不读取聊天" Style="{StaticResource Hint}" HorizontalAlignment="Right" FontSize="10"/></Grid>
      <Border Grid.Row="1" Background="#E8F1EC" CornerRadius="18" BorderBrush="#D9E6DF" BorderThickness="1" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="Preview" CornerRadius="12" ClipToBounds="True" Background="#E9F6F0"/><TextBlock x:Name="PreviewHelp" Grid.Row="1" Text="点击预览区域可编辑配色 · 窗口比例以实际微信为准" FontSize="10" Foreground="#6C887C" HorizontalAlignment="Center" Margin="0,12,0,0"/><Border x:Name="CompositionTools" Grid.Row="2" Visibility="Collapsed" Background="#F8FFFC" CornerRadius="10" Padding="12" Margin="0,10,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="缩放" VerticalAlignment="Center" FontSize="11"/><Slider x:Name="CompositionZoom" Grid.Column="1" Minimum="1" Maximum="8" Value="1" Margin="12,4" SmallChange="0.1" LargeChange="0.5" AutomationProperties.Name="构图缩放"/><TextBlock x:Name="CompositionScale" Grid.Column="2" Text="1.00×" VerticalAlignment="Center" FontSize="11"/></Grid><UniformGrid Columns="3" Margin="0,10,0,0"><Button x:Name="ResetComposition" Content="重置" Padding="8,7" Margin="0,0,6,0"/><Button x:Name="CancelComposition" Content="取消" Padding="8,7" Margin="0,0,6,0"/><Button x:Name="SaveComposition" Content="保存构图" Padding="8,7" Background="#39C5BB" BorderThickness="0"/></UniformGrid></StackPanel></Border></Grid></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="17" Margin="0,15,0,0"><StackPanel><TextBlock x:Name="ContrastSummary" Text="文字可读性检查" FontWeight="SemiBold" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="ImproveContrast" Content="采用建议遮罩" Padding="10,5" FontSize="10" IsEnabled="False"/><Button x:Name="UndoContrast" Content="撤销" Padding="10,5" FontSize="10" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="恢复采用建议前的遮罩；手动调整后撤销失效"/></StackPanel><TextBlock x:Name="ContrastDetails" Text="检查背景与文字之间的对比度。" Style="{StaticResource Hint}" FontSize="10" LineHeight="18" Margin="0,9,0,0" MaxHeight="112"/></StackPanel></Border>
     </Grid>
    </Grid>
    <Border x:Name="GuidePage" Visibility="Collapsed" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="三步，把喜欢的样子留在微信里。" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="首次设置约 1 分钟。背景图片只在本机处理。" Style="{StaticResource Hint}" Margin="0,10,0,25"/>
      <UniformGrid Columns="3"><Border Background="#E4F5EF" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="01" FontSize="30" Foreground="#168E85"/><TextBlock Text="选一个主题" Style="{StaticResource Heading}" Margin="0,18,0,10"/><TextBlock Text="在「主题空间」选择青屿，或到「背景与构图」导入图片，在右侧示意图中构图。" Style="{StaticResource Hint}"/></StackPanel></Border><Border Background="#EDF4EF" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="02" FontSize="30" Foreground="#168E85"/><TextBlock Text="启动主题微信" Style="{StaticResource Heading}" Margin="0,18,0,10"/><TextBlock Text="先在微信托盘菜单点「退出」，再点击本客户端底部的「启动主题微信」，自行完成登录。" Style="{StaticResource Hint}"/></StackPanel></Border><Border Background="#F1F3E8" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="03" FontSize="30" Foreground="#168E85"/><TextBlock Text="调整并应用" Style="{StaticResource Heading}" Margin="0,18,0,10"/><TextBlock Text="修改模糊、遮罩或分区颜色，检查预览后点「更新主题」。以微信里的实际效果为准。" Style="{StaticResource Hint}"/></StackPanel></Border></UniformGrid>
      <Grid Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="图片怎样框选？" Style="{StaticResource Heading}" FontSize="15"/><TextBlock Text="选图后，在右侧示意图拖动图片，滚轮或滑杆缩放。虚线标出导航、会话、标题、聊天与输入区。点「保存构图」再更新主题；取消或切换页面会丢弃草稿。原图不会被改动。" Style="{StaticResource Hint}"/><TextBlock Text="普通启动为什么没有主题？" Style="{StaticResource Heading}" FontSize="15" Margin="0,22,0,10"/><TextBlock Text="主题只在本客户端启动的微信进程里加载。以后请使用这里的启动按钮；已运行的普通微信需要先从托盘退出。" Style="{StaticResource Hint}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="怎样恢复默认？" Style="{StaticResource Heading}" FontSize="15"/><TextBlock Text="点击底部「恢复默认」即可停用主题。再从托盘退出微信，使用原微信入口打开，进程内引擎会完全卸载。" Style="{StaticResource Hint}"/><TextBlock Text="关于毛玻璃与适配范围" Style="{StaticResource Heading}" FontSize="15" Margin="0,22,0,10"/><TextBlock Text="当前提供背景模糊与分区半透明叠色，尚未实现实时透出桌面的毛玻璃。当前适配聊天主界面。示意图为 19:10 的分区参考，不读取真实按钮坐标；改变微信窗口比例或分栏宽度后，请核对实际效果。" Style="{StaticResource Hint}"/></StackPanel></Grid>
      <Border Background="#DCF3EC" CornerRadius="12" Padding="16" Margin="0,24,0,0"><StackPanel><TextBlock Text="关于微信美化 · 0.7.1-preview.1" Style="{StaticResource Heading}" FontSize="16"/><TextBlock Text="非官方开源实验工具。进程内加载主题引擎，不保证不封号，请自行评估使用。检查新版本会打开 GitHub Releases，请核对页面上的版本号。" Style="{StaticResource Hint}"/><WrapPanel Margin="0,12,0,0"><Button x:Name="CheckUpdates" Content="检查新版本  ↗" Background="#39C5BB" BorderThickness="0" Margin="0,0,8,0"/><Button x:Name="OpenGitHub" Content="GitHub 项目" Margin="0,0,8,0"/><Button x:Name="OpenBilibili" Content="B 站视频教程  ↗"/></WrapPanel></StackPanel></Border>
      <Border Background="#EAF6F1" CornerRadius="10" Padding="16" Margin="0,24,0,0"><StackPanel><TextBlock Text="版本系列与实测范围" Style="{StaticResource Heading}" FontSize="15"/><TextBlock x:Name="CompatibilityGuide" Style="{StaticResource Hint}"/></StackPanel></Border><Border Background="#F5F8F6" CornerRadius="10" Padding="14" Margin="0,16,0,0"><TextBlock Text="遇到问题：先检查客户端是否为最新版本 → 确认微信版本 → 完全退出后重新启动 → 保持聊天主窗口可见 → 导出诊断。诊断包含本机路径，不含聊天内容。" Style="{StaticResource Hint}"/></Border>
    </StackPanel></ScrollViewer></Border>
   </Grid>
   <Grid Grid.Row="2" Margin="0,19,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="Actions" Orientation="Horizontal"><Button x:Name="Launch" Content="启动主题微信  ↗" Background="#173F37" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,9,0"/><Button x:Name="Apply" Content="更新主题" Background="#39C5BB" BorderThickness="0" Foreground="#103B3A" Margin="0,0,9,0"/><Button x:Name="Restore" Content="恢复默认"/></StackPanel><Button x:Name="Report" ToolTip="请确保使用的是最新版本后再反馈。可在「使用指南」检查新版本。" ToolTipService.ShowDuration="12000" Grid.Column="1" Content="导出诊断" Background="Transparent" BorderThickness="0" Foreground="#678376"/></Grid><TextBlock x:Name="Status" Grid.Row="1" Text="正在初始化…" Foreground="#68827B" FontSize="11" Margin="0,11,0,0" MinHeight="31" MaxHeight="48" LineHeight="17"/></Grid>
  </Grid>
 </Grid>
</Window>
